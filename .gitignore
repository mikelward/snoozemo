# Ignore all dotfiles and dot-directories by default; allowlist below.
.*
!/.github
!/.github/**
!/.gitignore
!.gitkeep
# Claude Code shared config (SessionStart hook + settings) must be tracked so
# remote web sessions pick it up; keep machine-local overrides ignored.
!/.claude
!/.claude/**
/.claude/settings.local.json
# Transient agent worktrees created by the Claude Code harness; never committed.
/.claude/worktrees/
# Transient scheduler lock/state from the Claude Code harness; session-local only.
/.claude/scheduled_tasks.lock
/.claude/scheduled_tasks.json

*.iml
/local.properties
# Every module's build output (:app, :core, :dnd, :presence, :tile, and the root).
build/
/captures
local.properties
*.keystore
*.jks
# The base64 encoding docs/play-store-internal-track.md has you generate on
# the way to pasting it into a GitHub secret -- exactly as sensitive as the
# keystore itself, and not covered by the two patterns above.
*.keystore.b64

# JVM fatal-error / replay crash dumps from forked test workers
hs_err_pid*.log
replay_pid*.log

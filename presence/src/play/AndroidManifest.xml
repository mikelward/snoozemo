<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The geofence transition target. Not exported: the sender is our own
          mutable PendingIntent, and an exported receiver would let any app on
          the phone fake a departure and end someone's snooze.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.GeofenceTransitionReceiver"
            android:exported="false" />

        <!--
          The grace alarm's target (SPEC.md 6.6). Not exported for the same
          reason: only our own alarm PendingIntent may say a grace period ran
          out, or any app could end a snooze five minutes after asking.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.GraceAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>

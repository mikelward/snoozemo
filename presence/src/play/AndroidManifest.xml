<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The geofence transition target. Not exported: the sender is our own
          mutable PendingIntent, and an exported receiver would let any app on
          the phone fake a departure and end someone's snooze.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.GeofenceTransitionReceiver"
            android:exported="false" />

        <!--
          The grace alarm's target (SPEC.md 6.6). Not exported for the same
          reason: only our own alarm PendingIntent may say a grace period ran
          out, or any app could end a snooze five minutes after asking.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.GraceAlarmReceiver"
            android:exported="false" />

        <!--
          The capability-loss alarm's target — a fail-open ending already
          decided and durably recorded (TODO.md). Not exported for the same
          reason as the receivers above: only our own alarm PendingIntent may
          prompt this, or any app could end a snooze on demand.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.CapabilityLossAlarmReceiver"
            android:exported="false" />
        <!--
          The Wi-Fi recheck alarm's target (SPEC.md 6.6): the durable
          stand-in for a geofence on an anchor that has none. Not exported
          for the same reason as the receivers above — it restores the
          service, and nothing outside this app has any business doing that
          on a schedule it chooses.
        -->
        <receiver
            android:name="app.snoozemo.presence.geofence.WifiRecheckAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>

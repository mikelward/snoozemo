<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The tile's name in the "add tile" picker: people scan that list for an
         app name, not a verb. -->
    <string name="tile_name">Snoozemo</string>
    <string name="tile_snooze_here">Snooze here</string>
    <string name="tile_snoozing">Snoozing</string>
    <string name="tile_timer_only">Timer only · %1$s</string>
    <string name="tile_state_off">Off</string>
    <string name="tile_state_on">Snoozing, %1$s</string>
    <!-- The countdown, with an hour or more left. Abbreviated because Quick
         Settings truncates the subtitle hard; %1$d is hours, %2$d minutes. -->
    <string name="tile_remaining_hours">%1$dh %2$dm left</string>
    <!-- The countdown inside the last hour. -->
    <string name="tile_remaining_minutes">%1$dm left</string>
</resources>

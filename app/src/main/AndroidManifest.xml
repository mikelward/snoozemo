<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No INTERNET permission today (SPEC.md §12): nothing can leave the
      device, which is what makes the Play Data Safety answer "no data
      collected, no data shared" trivially auditable. Not a permanent
      constraint — Crashlytics or similar is expected later, gated by a
      user-facing opt-out — but adding it is a product decision, not an
      implementation detail, and the day it lands this comment and §12 both
      need to say so.
    -->

    <!--
      The location family both flavors share (SPEC.md §3.4; declared with the
      maintainer's approval, 2026-08-22): the departure test needs a fine fix —
      §6.6's accuracy gate cannot pass on coarse — and COARSE is declared
      beside it because Android 12+ lets the user downgrade the grant, so a
      request for FINE alone would be refused outright instead of downgraded.
      ACCESS_BACKGROUND_LOCATION is the `play` flavor's alone (its manifest);
      the `direct` flavor holds no restricted permission (§3.4), pinned by
      DeclaredPermissionsTest.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      The Wi-Fi suppressor (SPEC.md §6.4, D4): association with the anchor's
      network is what lets the duty cycle do no location work while the user
      is demonstrably still there. State only — Snoozemo never changes Wi-Fi.

      ACCESS_NETWORK_STATE rides in beside it from the `:presence` manifest,
      which declares it for the network callback the SSID read goes through.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Manifest-declared, but granted through a settings screen rather than a
      runtime dialog (SPEC.md §5.2) — there is no runtime prompt for this one,
      which is why onboarding has to send the user to Settings and listen for
      the grant coming back.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      The ongoing "you are snoozed" notification, and the ended one. Requested at
      runtime too (MainActivity): declaring it grants nothing since Android 13,
      and without the grant every degraded-mode and failure message the app
      relies on to not fail silently is dropped by the system.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      A reboot clears every scheduled alarm and restarts nothing, so without this
      an active snooze survives in the platform's zen rule with nothing left in
      the app to end it (SPEC.md §8.1).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SnoozemoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snoozemo">

        <!--
          WorkManager's automatic App Startup initializer is removed, and only
          its own: initializing on process startup puts database work ahead of
          a cold tile tap's ACTION_ARM (SPEC.md §4.1; Codex, PR #75), and the
          first thing that needs WorkManager is the backstop schedule, which
          runs after the rule is already on. The Application provides the
          configuration, so WorkManager initializes on first use instead. The
          provider itself is merged, not removed — other libraries' startup
          entries keep working.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Long-pressing the tile lands here (SPEC.md §4.2). It is also the
              rule's configurationActivity, so the entry Settings offers next to
              Snoozemo's DND rule goes to the same place.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Started by the tile's trampoline; owns the running snooze. -->
        <service
            android:name=".snooze.SnoozeService"
            android:exported="false" />

        <!--
          Transparent, and on the arm path: it starts the service before any UI
          so arming never waits on rendering (SPEC.md §6.9). The action is how
          :tile launches it without a compile-time dependency on :app.

          Deliberately not android:noHistory: this activity outlives its own
          first frame when it hosts the notification-permission dialog, and will
          again for the Phase 4 end-condition sheet. noHistory would finish it
          the moment the dialog took the foreground, dropping the result. It
          always finishes itself instead, and excludeFromRecents keeps it out of
          the recents list either way.

          exported="false", and no intent-filter: an exported trampoline lets any
          app on the phone silence it for the default cap. :tile names this class
          explicitly instead, and the PendingIntent the system invokes carries
          this app's identity, so nothing here needs to be reachable from
          outside.
        -->
        <activity
            android:name=".snooze.TileTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Snoozemo.Transparent" />

        <receiver
            android:name=".snooze.CapAlarmReceiver"
            android:exported="false" />

        <!--
          Backs the `Dismiss` action on the stuck-rule notification. Not
          exported: the only sender is our own PendingIntent, and letting anyone
          else clear that card would remove the one affordance pointing at a
          rule that may still be silencing the phone.
        -->
        <receiver
            android:name=".snooze.NotificationActionReceiver"
            android:exported="false" />

        <!-- Exported because the sender is the system (SPEC.md §8.1). -->
        <receiver
            android:name=".snooze.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                  An update leaves the same wreckage a reboot does — a record on
                  disk, no process alive, and the zen rule still on — so it takes
                  the same repair. It is also the one moment a snooze outlives
                  the build that armed it, which is when a record written by an
                  older build meets a newer one that will not vouch for it: left
                  unhandled, that reads as no snooze at all while the phone stays
                  quiet (SPEC.md §12).
                -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          The cap alarm counts in elapsed realtime, which a wall-clock change
          does not move — so a clock moved *forward* past the deadline leaves
          the countdown reading zero while the alarm waits out the original
          duration (SPEC.md §7). This is what closes that gap. TIME_SET is one of
          the implicit broadcasts still delivered to manifest receivers,
          precisely so apps can reschedule alarms after a clock change.

          Not exported: the system reaches a private receiver for its own
          broadcasts, and exporting would let any app forge a clock change and
          drive a cap check — ending someone's snooze on demand. Matches the
          sibling Simmo repo's DataWatchReceiver, which takes the same
          system-broadcast-only receiver private for the same reason.
        -->
        <receiver
            android:name=".snooze.TimeChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

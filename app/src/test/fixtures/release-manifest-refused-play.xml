<?xml version="1.0" encoding="utf-8"?>
<!--
  A merged manifest the play release rules must refuse, for
  `verifyPlayReleaseManifestProof` (app/build.gradle.kts): the ad identifier, a
  typed foreground-service permission that is *not* the allowed one, a service
  carrying a foregroundServiceType that is *not* the required one — which is two
  rules at once, the wrong type declared and the right one absent — and all four
  of play's required grants missing or defeated — background location absent,
  INTERNET capped by maxSdkVersion (which on a device this app runs on is the
  same as missing), and both foreground-service grants absent: the base one and
  the location one, which a typed startForeground needs together. Every
  rule the guard has fires on it, and CI asserts each rule's own diagnostic, so
  a guard that stops firing on any one of them is caught there rather than by a
  Play rejection. The ad identifier arrives through the SDK-qualified element on
  purpose: that is the form the guard could most easily overlook.

  What this fixture deliberately does *not* prove is the accepting half — that
  `FOREGROUND_SERVICE_LOCATION` and `foregroundServiceType="location"` pass. A
  fixture cannot be both refused and accepted, and the real merged manifests are
  the better witness anyway: CI runs `verifyPlayReleaseManifest` against them in
  the same step, and the play build ships exactly that permission and that type.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.snoozemo">
    <uses-permission-sdk-23 android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" android:maxSdkVersion="34" />
    <application android:label="Snoozemo">
        <service
            android:name="app.snoozemo.snooze.SnoozeService"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
